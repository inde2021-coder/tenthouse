{
  "rules": {
    ".read": false,
    ".write": false,
    "tent_erp_data": {
      ".read": "auth != null && root.child('erp_admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('erp_admins').child(auth.uid).val() === true"
    },
    "erp_admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
