# Copy to .env for local development only. Never commit .env or real credentials.
# Production requires Node.js 22+ and a persistent Firebase Admin connection.
PORT=10000
PUBLIC_ORIGIN=http://localhost:3000
FIREBASE_DATABASE_URL=
# Set either FIREBASE_SERVICE_ACCOUNT_JSON or all three split fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_API_TOKEN=
OTP_HMAC_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Preview only: PREVIEW_MODE=true requires NODE_ENV=development and uses non-persistent demo data.
PREVIEW_MODE=false
