# Copy these values into the backend host's environment settings.
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://YOUR-FRONTEND-DOMAIN
ADMIN_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Firebase Realtime Database service account (server only; NEVER put in frontend or Git).
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"REPLACE","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"REPLACE","token_uri":"https://oauth2.googleapis.com/token"}

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON: use all three split variables.
# FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@YOUR_PROJECT_ID.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\nREPLACE\\n-----END PRIVATE KEY-----\\n

# Optional provider configuration
OTP_PROVIDER=none
OTP_TTL_SECONDS=300
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MAX_TOKENS=1200
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Aoede
